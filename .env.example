# Pinterest API Credentials
# Get your App ID and Secret at https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Pinterest OAuth Access Token (can be populated automatically via `bun run auth`)
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=

# Environment Settings
# Set to true to target https://api-sandbox.pinterest.com/v5 instead of production
PINTEREST_SANDBOX=false

# OAuth Local Callback Port
PINTEREST_REDIRECT_PORT=3000

# MCP Server Settings (Optional: for HTTP/SSE mode)
# MCP_TRANSPORT=stdio # or 'sse'
PORT=8080
